{
  "info": {
    "name": "Lost & Found MVP API",
    "description": "Bộ sưu tập API cho hệ thống Lost & Found Backend (Spring Boot MVP)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdItemId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Login (User mặc định)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('JWT Token saved successfully!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0912345678\",\n  \"password\": \"user\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Đăng nhập bằng số điện thoại và mật khẩu. Tự động lưu JWT Token vào biến collection {{token}}."
          }
        },
        {
          "name": "1.2 Login (Admin mặc định)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('Admin JWT Token saved!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0987654321\",\n  \"password\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Register (Đăng ký tài khoản mới)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van A\",\n  \"phone\": \"0933445566\",\n  \"password\": \"Password@123\",\n  \"email\": \"nguyenvana@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "1.4 Get Current User (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Users Profile",
      "item": [
        {
          "name": "2.1 Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van A Updated\",\n  \"phone\": \"0912345678\",\n  \"avatarUrl\": \"https://example.com/avatar.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Items Management",
      "item": [
        {
          "name": "3.1 Create Lost Item (Báo mất đồ)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('createdItemId', jsonData.data.id);",
                  "    console.log('Saved createdItemId:', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemName\": \"Ví da nam cầm tay màu nâu\",\n  \"category\": \"Ví / Giấy tờ\",\n  \"description\": \"Đánh rơi ví da màu nâu bên trong có CCCD và thẻ ngân hàng\",\n  \"color\": \"Nâu\",\n  \"brand\": \"Pedro\",\n  \"size\": \"Nhỏ\",\n  \"material\": \"Da bò\",\n  \"location\": \"Căn tin tòa nhà A, Đại học FPT\",\n  \"eventDate\": \"2026-09-20\",\n  \"eventTime\": \"14:30:00\",\n  \"imageUrl\": \"https://example.com/item.jpg\",\n  \"additionalCharacteristics\": \"Có vết xước nhỏ ở góc phải mặt sau\",\n  \"contactPhone\": \"0912345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/lost",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "lost"]
            }
          }
        },
        {
          "name": "3.2 Create Found Item (Báo nhặt được đồ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemName\": \"Chùm chìa khóa xe máy Honda\",\n  \"category\": \"Chìa khóa\",\n  \"description\": \"Nhặt được chùm 3 chìa khóa có móc treo hình gấu Doraemon\",\n  \"color\": \"Bạc\",\n  \"brand\": \"Honda\",\n  \"location\": \"Bãi giữ xe khu B\",\n  \"eventDate\": \"2026-09-20\",\n  \"eventTime\": \"16:00:00\",\n  \"imageUrl\": \"https://example.com/keys.jpg\",\n  \"contactPhone\": \"0912345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/found",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "found"]
            }
          }
        },
        {
          "name": "3.3 Get Items List (Tìm kiếm & Lọc)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items?keyword=ví&type=LOST&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items"],
              "query": [
                {
                  "key": "keyword",
                  "value": "ví",
                  "description": "Từ khóa tìm kiếm (tên, mô tả, địa điểm)"
                },
                {
                  "key": "type",
                  "value": "LOST",
                  "description": "LOST hoặc FOUND"
                },
                {
                  "key": "status",
                  "value": "LOST",
                  "disabled": true,
                  "description": "LOST, FOUND, RETURNED, CLOSED"
                },
                {
                  "key": "category",
                  "value": "Ví / Giấy tờ",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "3.4 Get Item By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/{{createdItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "{{createdItemId}}"]
            }
          }
        },
        {
          "name": "3.5 Get My Items (Bài đăng của tôi)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/my-posts?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "my-posts"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "3.6 Close Item (Đóng / Đã nhận lại đồ)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RETURNED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/{{createdItemId}}/close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "{{createdItemId}}", "close"]
            }
          }
        }
      ]
    }
  ]
}
