      "name": "1. Accounts",
      "item": [
        {
          "name": "01 Register owner",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now().toString(36);",
                  "pm.collectionVariables.set('runId', runId);",
                  "pm.collectionVariables.set('eventDate', new Date().toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"API success\", function () { pm.expect(json.success).to.eql(true); });",
                  "pm.collectionVariables.set('ownerToken', json.data.token);",
                  "pm.collectionVariables.set('ownerId', json.data.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Owner\",\n  \"email\": \"owner-{{runId}}@example.com\",\n  \"password\": \"Password@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "02 Register finder",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"API success\", function () { pm.expect(json.success).to.eql(true); });",
                  "pm.collectionVariables.set('finderToken', json.data.token);",
                  "pm.collectionVariables.set('finderId', json.data.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Finder\",\n  \"email\": \"finder-{{runId}}@example.com\",\n  \"password\": \"Password@123\"\n}",
